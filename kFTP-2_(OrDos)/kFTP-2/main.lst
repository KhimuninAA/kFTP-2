13176 3E89              ; 127 //        INX D ;FOR TWO'S COMPLEMENT
13177 3E89              ; 128 //        LXI H, 0 ;INITIAL VALUE FOR REMAINDER
13178 3E89              ; 129 //        MVI A, 17 ;INITIALIZE LOOP COUNTER
13179 3E89              ; 130 //        DV0: PUSH H ;SAVE REMAINDER
