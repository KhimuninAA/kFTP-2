13195 3E89              ; 146 //        RAL
13196 3E89              ; 147 //        MOV H, A
13197 3E89              ; 148 //        POP PSW ;RESTORE LOOP COUNTER (A)
13198 3E89              ; 149 //        DCR A ;DECREMENT IT
13199 3E89              ; 150 //        JNZ DV0 ;KEEP LOOPING
13200 3E89              ; 151 //        ;POST-DIVIDE CLEAN UP
13201 3E89              ; 152 //        ;SHIFT REMAINDER RIGHT AND RETURN IN DE
13202 3E89              ; 153 //        ORA A
13203 3E89              ; 154 //        MOV A, H
13204 3E89              ; 155 //        RAR
13205 3E89              ; 156 //        MOV D, A
13206 3E89              ; 157 //        MOV A, L
13207 3E89              ; 158 //        RAR
13208 3E89              ; 159 //        MOV E, A
13209 3E89              ; 160     }
